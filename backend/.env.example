# MyCashbridge Lead API — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
DB_NAME=mycashbridge
PORT=3001
ALLOWED_ORIGIN=https://mycashbridge.com

# ── Domestic LMS Integration ─────────────────────────────────────────────────
# Website keeps its own copy AND forwards every lead to the Domestic LMS intake API.
# Set these to the actual deployed domestic server URL and API key.
DOMESTIC_LMS_URL=http://localhost:5001
DOMESTIC_LMS_API_KEY=dom-website-intake-key-change-in-production-2024
ADMIN_API_KEY=your-admin-secret-key-change-in-production

# ── Signzy CIBIL Consumer Bureau API ──────────────────────────────────────────
# Signzy Authorization Token (Header: Authorization: <token>)
SIGNZY_AUTH_TOKEN=
# Environment: 'production' (https://api.signzy.app) or 'preproduction' (https://api-preproduction.signzy.app)
SIGNZY_ENV=preproduction
